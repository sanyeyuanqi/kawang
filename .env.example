# Kawang Shop environment template
# Copy this file to .env, then replace every placeholder before production use.

APP_NAME=Kawang Shop
DEBUG=false
SITE_URL=http://localhost
BACKEND_ENV_FILE=.env

# Docker MySQL bootstrap
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DATABASE=shop

# Backend database and cache
DATABASE_URL=mysql+asyncmy://root:change-me-mysql-root-password@mysql:3306/shop
DATABASE_URL_SYNC=mysql+pymysql://root:change-me-mysql-root-password@mysql:3306/shop
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100

# Backend runtime concurrency
UVICORN_WORKERS=4
SCHEDULER_LOCK_FILE=/tmp/kawang_scheduler.lock

# Auth
JWT_SECRET=change-me-to-a-random-string-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS, JSON array syntax is required for pydantic-settings.
CORS_ORIGINS=["http://localhost","http://localhost:5173","http://127.0.0.1:5173"]

# Uploads
MAX_UPLOAD_SIZE=5242880

# Haozpay
HAOZPAY_MERCHANT_NO=
HAOZPAY_PRIVATE_KEY=
HAOZPAY_PLATFORM_PUBLIC_KEY=
HAOZPAY_API_BASE_URL=https://gate.haozpay.com
HAOZPAY_DEBUG=false
HAOZPAY_QUERY_ENABLED=false

# SMTP
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Seeded admin account
ADMIN_USERNAME=sanye
ADMIN_PASSWORD=change-me-admin-password

# Limits
EMAIL_CODE_EXPIRE_SECONDS=300
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300
ORDER_EXPIRE_MINUTES=15

# Pagination
PAGE_DEFAULT_SIZE=20
PAGE_MAX_SIZE=100
